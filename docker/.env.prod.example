# Server deployment config. Copy to `.env` next to docker-compose.yml and fill
# in real values. NEVER commit the real .env.
# Generate secrets with: python -c "import secrets; print(secrets.token_hex(32))"

# ---- First-time GHCR login (one time per server) -------------------------
# The release images are private, so authenticate this server to GHCR before
# the first `docker compose pull`:
#   echo "<TOKEN>" | docker login ghcr.io -u <github-username> --password-stdin
# Token needs the read:packages scope only. Do NOT store the token in this file.

# ---- Which images to run -------------------------------------------------
GHCR_OWNER=crazz-zaac
VERSION=v1.0.0          # the released tag to run (matches `git tag`)
HTTP_PORT=80            # host port the site is served on

# ---- Database (service name is `db`) -------------------------------------
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER=yugantar_admin
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=yugantar_db
# ---- Row-Level Security (optional; see docker-compose header step 2b) -----
# Set both to run the app under RLS. The backend/worker connect as this
# non-superuser role (created on first DB boot by create-app-role.sh); the
# owner POSTGRES_USER keeps running migrations. Leave blank to keep connecting
# as POSTGRES_USER (RLS inert). Use a password WITHOUT quote characters.
# POSTGRES_APP_USER=yugantar_app
# POSTGRES_APP_PASSWORD=CHANGE_ME

# ---- Redis / Celery (service name is `redis`) ----------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# ---- First admin account (created on startup) ----------------------------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME

# ---- URLs (use your real domain) -----------------------------------------
FRONTEND_HOST=https://your-domain.org
BACKEND_HOST=https://your-domain.org
BACKEND_CORS_ORIGINS=https://your-domain.org

# ---- Security ------------------------------------------------------------
SECRET_KEY=CHANGE_ME
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ---- Email ---------------------------------------------------------------
SMTP_SERVER=smtp.gmail.com
SMTP_TLS=True
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=
EMAILS_FROM_NAME=Yugantar Cooperative

# ---- Storage (persisted in named volumes) --------------------------------
RECEIPT_STORAGE_DIR=/data/receipts
RECEIPT_RETENTION_DAYS=15
DOCUMENT_STORAGE_DIR=/data/documents

# ---- Online meetings (JaaS) — leave blank to disable ---------------------
# Put the private key file at ./secrets/jaas_private_key.pk on the server.
JAAS_APP_ID=
JAAS_API_KEY_ID=
JAAS_PRIVATE_KEY_PATH=/app/secrets/jaas_private_key.pk
