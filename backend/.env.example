# Copy to backend/.env and fill in real values. Never commit backend/.env.
# Generate secrets with: python -c "import secrets; print(secrets.token_hex(32))"

# Database
POSTGRES_SERVER=db # using service name defined in docker-compose.yml -> db
POSTGRES_PORT=5432
POSTGRES_USER=yugantar_admin
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=yugantar_db
# Admin User
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME
# CORS
BACKEND_CORS_ORIGINS=http://localhost,http://localhost:3000
# SMTP CONFIGURATION
SMTP_SERVER=smtp.gmail.com
SMTP_TLS=True
SMTP_PORT=587
SMTP_USER=
EMAILS_FROM_EMAIL=
EMAILS_FROM_NAME=Yugantar Dev Team
SMTP_PASSWORD=

# Security
SECRET_KEY=CHANGE_ME
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# PGAdmin
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME

# Receipt images (private volume, deleted N days after upload)
RECEIPT_STORAGE_DIR=/data/receipts
RECEIPT_RETENTION_DAYS=15
