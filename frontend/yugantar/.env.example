# Copy to frontend/yugantar/.env and adjust. Only VITE_-prefixed vars are read
# by the app (Vite, src/config/env.ts). The Docker dev stack mounts this folder,
# so the frontend container reads this same .env on start.

VITE_APP_TITLE="Yugantar Wealth Management System"

# Base URL of the backend API, including the /api/v1 prefix. Use a URL the
# browser can reach (the host-exposed backend port), e.g. for local dev:
VITE_API_BASE=http://localhost:8001/api/v1
